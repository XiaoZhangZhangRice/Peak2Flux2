flux2acc <- function(data) {
flux_df <- data %>%
mutate(Date =as.Date(Date, format = "%d-%b-%y"))
start_date <- min(flux_df$Date)
end_date <- max(flux_df$Date)
date_seq <- seq.Date(start_date, end_date, by = "day")
# full_dates <- data.frame(Date = seq(start_date, end_date, by = "day"))
#
# flux_df <- merge(full_dates, flux_df, by = "Date", all.x = TRUE) %>%
#   group_by()
flux_df <- flux_df %>%
group_by(Plot) %>%
complete(Date = date_seq) %>%
mutate(CH4_flux_corrected = na.approx(CH4_flux_corrected, rule = 2),
N2O_flux_corrected = na.approx(N2O_flux_corrected, rule = 2),
CO2_flux_corrected = na.approx(CO2_flux_corrected, rule = 2)) %>%
ungroup()
# return(list(
#   data = flux_df,
#   start_date = start_date,
#   end_date = end_date,
#   full_dates = full_dates))
}
input_acc_test1 <- flux2acc(flux_df_testA)
flux2acc <- function(data) {
Gases <- c("CH4", "N2O", "CO2", "Gas1", "Gas2", "Gas3")
flux_df <- data %>%
mutate(Date =as.Date(Date, format = "%d-%b-%y"))
start_date <- min(flux_df$Date)
end_date <- max(flux_df$Date)
date_seq <- seq.Date(start_date, end_date, by = "day")
# full_dates <- data.frame(Date = seq(start_date, end_date, by = "day"))
#
# flux_df <- merge(full_dates, flux_df, by = "Date", all.x = TRUE) %>%
#   group_by()
## 1.1. Flux calculation ####
for(gas in Gases) {
flux_col <- paste0(gas, "_flux_corrected")
flux_df <- flux_df %>%
group_by(Plot) %>%
complete(Date = date_seq) %>%
ungroup()
if (flux_col %in% names(flux_df)) {
flux_df <- flux_df %>%
mutate("{flux_col}" := na.approx(.data[[flux_col]], rule = 2)) %>%
ungroup()
return(flux_df)
} # closes if() for flux_col %in% names(flux_df)
} # closes for(gas in Gases)
} # closes f(x)
input_acc_test1 <- flux2acc(flux_df_testA)
View(input_acc_test1)
